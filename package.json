{
  "name": "duo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "npm run db:deploy && next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/migrate.ts --reset && tsx scripts/seed.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "user:create": "tsx scripts/create-user.ts",
    "test:all": "vitest run && playwright test",
    "brand:assets": "tsx scripts/brand-assets.ts",
    "db:deploy": "tsx scripts/check-env.ts && tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "start:web": "next start -p ${PORT:-3000}"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hookform/resolvers": "^6.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "next": "^15.5.28",
    "playwright-core": "^1.63.0",
    "postgres": "^4.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
