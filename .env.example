# --- Tryb pracy ---------------------------------------------------------
# DEMO_MODE=true: jawne środowisko demonstracyjne z danymi syntetycznymi.
# Wyświetla baner "DEMO" i pozwala korzystać z niezatwierdzonych tekstów prawnych.
# W produkcji ustaw DEMO_MODE=false.
DEMO_MODE=true

# Publiczny adres aplikacji (używany do budowania linków dla klientów).
APP_URL=http://localhost:3000

# --- Baza danych (PostgreSQL 15+) ----------------------------------------
# Rola właściciela schematu – używana WYŁĄCZNIE do migracji i seedów.
DATABASE_OWNER_URL=postgres://duo_owner:duo_owner_dev@localhost:5432/duo
# Rola aplikacji – bez uprawnień superużytkownika, podlega politykom RLS.
DATABASE_URL=postgres://duo_app:duo_app_dev@localhost:5432/duo

# --- Sekrety ---------------------------------------------------------------
# 32 bajty w base64, np.: openssl rand -base64 32
# Klucz szyfrowania pól wrażliwych (odpowiedzi, notatki, raporty). Utrata klucza = utrata danych.
DATA_ENCRYPTION_KEY=
# Sekret do HMAC tokenów (linki, sesje). openssl rand -base64 32
TOKEN_SECRET=

# Wymuś MFA (TOTP) dla specjalistów. W produkcji zawsze true.
REQUIRE_MFA=false

# Ścieżka do Chromium do generowania PDF (Playwright). Puste = domyślna.
CHROMIUM_PATH=

# --- Integracje (opcjonalne, domyślnie wyłączone) -------------------------
# Powiadomienie e-mail o nowym pytaniu z formularza „Masz pytania?” (bez treści pytania).
# Przykład: SMTP_URL=smtps://uzytkownik:haslo@smtp.dostawca.pl:465
SMTP_URL=
SMTP_FROM=
NOTIFY_EMAIL=
# Linki i kody do kwestionariuszy NIE są wysyłane e-mailem – psycholog kopiuje je ręcznie.
# Brak integracji płatności: link do płatności ustawiasz w panelu (Ustawienia),
# a status płatności oznacza ręcznie psycholog.
# Brak integracji z modelami AI: generator raportu działa lokalnie, na szablonie.
